{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nominal AISC section catalogue in inches and square inches",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "units", "source", "sections"],
  "properties": {
    "schema": {"const": "aisc-shapes/1"},
    "units": {"const": {"length": "in", "area": "in^2"}},
    "source": {
      "type": "object",
      "required": ["catalog_id", "publication", "url", "sha256", "retrieved_on", "access_note"],
      "properties": {
        "catalog_id": {"const": "aisc-shapes"},
        "publication": {"const": "AISC Shapes Database v16.0, August 2023"},
        "url": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "retrieved_on": {"type": "string", "format": "date"},
        "access_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "metric_name", "aliases", "family", "area", "dimensions", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "metric_name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "metric_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "family": {"enum": ["W", "S", "HP", "C", "L", "HSS_RECT", "HSS_ROUND", "PIPE"]},
          "area": {"type": "number", "exclusiveMinimum": 0},
          "dimensions": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"enum": ["d", "b", "bf", "tf", "tw", "t", "tnom", "kdes"]},
            "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
          },
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["sheet", "row", "columns"],
            "properties": {
              "sheet": {"const": "Database v16.0"},
              "row": {"type": "integer", "minimum": 2},
              "area_number_format": {"type": "string", "minLength": 1},
              "columns": {"type": "object", "minProperties": 1,
                "additionalProperties": {"type": "string", "pattern": "^[A-Z]+$"}}
            }
          }
        }
      }
    }
  }
}
