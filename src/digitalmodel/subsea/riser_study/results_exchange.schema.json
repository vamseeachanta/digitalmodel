{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riser exported strength and fatigue results",
  "description": "Numeric quantities use the units in field names. Zero fatigue damage has null life. Method and allowable describe the normalised strength samples.",
  "oneOf": [
    {
      "$ref": "#/$defs/strength"
    },
    {
      "$ref": "#/$defs/fatigue"
    }
  ],
  "$defs": {
    "run": {
      "type": "object",
      "properties": {
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "result_file": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "input_sha256",
        "result_file",
        "date"
      ],
      "additionalProperties": false
    },
    "strength": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^R(?:08|10|12)-W[12]-(?:SCR|SLWR)$"
        },
        "software": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "load_case": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "wave": {
              "type": "object",
              "minProperties": 1
            },
            "current": {
              "type": "object",
              "minProperties": 1
            },
            "offset": {
              "type": "object",
              "properties": {
                "x_m": {
                  "type": "number"
                },
                "y_m": {
                  "type": "number"
                }
              },
              "required": [
                "x_m",
                "y_m"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "wave",
            "current",
            "offset"
          ],
          "additionalProperties": false
        },
        "arc_length_m": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2
        },
        "effective_tension_kN": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2
        },
        "bending_moment_kNm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2
        },
        "von_mises_utilisation": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "allowable": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "MPa"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "unit",
            "source"
          ],
          "additionalProperties": false
        },
        "max_utilisation": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "arc_length_m": {
              "type": "number",
              "minimum": 0
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "arc_length_m",
            "location"
          ],
          "additionalProperties": false
        },
        "touchdown": {
          "type": "object",
          "properties": {
            "arc_length_m": {
              "type": "number",
              "minimum": 0
            },
            "utilisation": {
              "type": "number",
              "minimum": 0
            },
            "stress_range_MPa": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "arc_length_m",
            "utilisation",
            "stress_range_MPa"
          ],
          "additionalProperties": false
        },
        "top_angle_deg": {
          "type": "object",
          "properties": {
            "static": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "dynamic_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "dynamic_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            }
          },
          "required": [
            "static",
            "dynamic_min",
            "dynamic_max"
          ],
          "additionalProperties": false
        },
        "hang_off_tension_kN": {
          "type": "object",
          "properties": {
            "static": {
              "type": "number"
            },
            "dynamic_max": {
              "type": "number"
            }
          },
          "required": [
            "static",
            "dynamic_max"
          ],
          "additionalProperties": false
        },
        "run": {
          "$ref": "#/$defs/run"
        }
      },
      "required": [
        "case_id",
        "software",
        "load_case",
        "arc_length_m",
        "effective_tension_kN",
        "bending_moment_kNm",
        "von_mises_utilisation",
        "method",
        "allowable",
        "max_utilisation",
        "touchdown",
        "top_angle_deg",
        "hang_off_tension_kN",
        "run"
      ],
      "additionalProperties": false
    },
    "fatigue": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^R(?:08|10|12)-W[12]-(?:SCR|SLWR)$"
        },
        "sea_state": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "Hs_m": {
              "type": "number",
              "minimum": 0
            },
            "Tp_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "direction_deg": {
              "type": "number"
            },
            "occurrence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "Hs_m",
            "Tp_s",
            "direction_deg",
            "occurrence"
          ],
          "additionalProperties": false
        },
        "hot_spots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hot_spot"
          }
        },
        "sn_curve": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "log_a": {
              "type": "number"
            },
            "thickness_correction": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "name",
            "source",
            "m",
            "log_a",
            "thickness_correction"
          ],
          "additionalProperties": false
        },
        "damage_per_year": {
          "type": "number",
          "minimum": 0
        },
        "life_years": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "$ref": "#/$defs/run"
        }
      },
      "required": [
        "case_id",
        "sea_state",
        "hot_spots",
        "sn_curve",
        "damage_per_year",
        "life_years",
        "run"
      ],
      "additionalProperties": false
    },
    "hot_spot": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "touchdown",
            "hang_off"
          ]
        },
        "arc_length_m": {
          "type": "number",
          "minimum": 0
        },
        "stress_range_MPa": {
          "type": "number",
          "minimum": 0
        },
        "range_histogram": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "stress_range_MPa": {
                "type": "number",
                "minimum": 0
              },
              "cycles_per_year": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "stress_range_MPa",
              "cycles_per_year"
            ],
            "additionalProperties": false
          }
        },
        "cycles_per_year": {
          "type": "number",
          "minimum": 0
        },
        "scf": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "name",
        "arc_length_m",
        "cycles_per_year",
        "scf"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "stress_range_MPa"
          ],
          "not": {
            "required": [
              "range_histogram"
            ]
          }
        },
        {
          "required": [
            "range_histogram"
          ],
          "not": {
            "required": [
              "stress_range_MPa"
            ]
          }
        }
      ]
    }
  }
}
