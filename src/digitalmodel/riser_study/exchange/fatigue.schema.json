{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ris-exchange/1 fatigue",
  "$ref": "#/$defs/fatigue",
  "$defs": {
    "arc_point": {
      "type": "object",
      "properties": {
        "arc_length_m": {
          "type": "number",
          "minimum": 0
        },
        "stress_range_MPa": {
          "type": "number",
          "minimum": 0
        },
        "range_histogram": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range_bin"
          },
          "minItems": 1
        },
        "cycles_per_year": {
          "type": "number",
          "minimum": 0
        },
        "scf": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage_per_year": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "arc_length_m",
        "cycles_per_year",
        "scf"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "stress_range_MPa"
          ]
        },
        {
          "required": [
            "range_histogram"
          ]
        }
      ]
    },
    "fatigue": {
      "type": "object",
      "properties": {
        "case_id": {
          "enum": [
            "R08-W1-SCR",
            "R08-W1-SLWR",
            "R08-W2-SCR",
            "R08-W2-SLWR",
            "R10-W1-SCR",
            "R10-W1-SLWR",
            "R10-W2-SCR",
            "R10-W2-SLWR",
            "R12-W1-SCR",
            "R12-W1-SLWR",
            "R12-W2-SCR",
            "R12-W2-SLWR"
          ]
        },
        "sea_state": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
            },
            "Hs_m": {
              "type": "number",
              "minimum": 0
            },
            "Tp_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "direction_deg": {
              "type": "number"
            },
            "occurrence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "Hs_m",
            "Tp_s",
            "direction_deg",
            "occurrence"
          ],
          "additionalProperties": false
        },
        "hot_spots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hot_spot"
          }
        },
        "sn_curve": {
          "$ref": "#/$defs/sn_curve"
        },
        "damage_per_year": {
          "type": "number",
          "minimum": 0
        },
        "life_years": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "arc_distribution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arc_point"
          },
          "minItems": 1
        },
        "exchange_version": {
          "const": "ris-exchange/1"
        }
      },
      "required": [
        "case_id",
        "sea_state",
        "hot_spots",
        "sn_curve",
        "damage_per_year",
        "run"
      ],
      "additionalProperties": false
    },
    "g4_check": {
      "type": "object",
      "properties": {
        "wall_delta_pct": {
          "type": "number"
        },
        "tolerance_pct": {
          "type": "number",
          "minimum": 0
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "wall_delta_pct",
        "tolerance_pct",
        "source_sha256"
      ],
      "additionalProperties": false
    },
    "g4_checks": {
      "type": "object",
      "properties": {
        "comparison_cases": {
          "type": "array",
          "items": {
            "enum": [
              "R08-W1-SCR",
              "R08-W1-SLWR",
              "R08-W2-SCR",
              "R08-W2-SLWR",
              "R10-W1-SCR",
              "R10-W1-SLWR",
              "R10-W2-SCR",
              "R10-W2-SLWR",
              "R12-W1-SCR",
              "R12-W1-SLWR",
              "R12-W2-SCR",
              "R12-W2-SLWR"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "mesh_step": {
          "$ref": "#/$defs/g4_check"
        },
        "half_hour": {
          "$ref": "#/$defs/g4_check"
        }
      },
      "required": [
        "comparison_cases",
        "mesh_step",
        "half_hour"
      ],
      "additionalProperties": false
    },
    "hot_spot": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "touchdown",
            "hang_off"
          ]
        },
        "arc_length_m": {
          "type": "number",
          "minimum": 0
        },
        "stress_range_MPa": {
          "type": "number",
          "minimum": 0
        },
        "range_histogram": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "stress_range_MPa": {
                "type": "number",
                "minimum": 0
              },
              "cycles_per_year": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "stress_range_MPa",
              "cycles_per_year"
            ],
            "additionalProperties": false
          }
        },
        "cycles_per_year": {
          "type": "number",
          "minimum": 0
        },
        "scf": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage_per_year": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "arc_length_m",
        "cycles_per_year",
        "scf"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "stress_range_MPa"
          ],
          "not": {
            "required": [
              "range_histogram"
            ]
          }
        },
        {
          "required": [
            "range_histogram"
          ],
          "not": {
            "required": [
              "stress_range_MPa"
            ]
          }
        }
      ]
    },
    "range_bin": {
      "type": "object",
      "properties": {
        "stress_range_MPa": {
          "type": "number",
          "minimum": 0
        },
        "cycles_per_year": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "stress_range_MPa",
        "cycles_per_year"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "result_file": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/text"
        },
        "phase": {
          "enum": [
            "A",
            "B"
          ]
        },
        "status": {
          "enum": [
            "attempted",
            "completed",
            "failed"
          ]
        },
        "qualified": {
          "type": "boolean"
        },
        "data_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "input_sha256",
        "result_file",
        "date"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "qualified": {
                "const": true
              }
            },
            "required": [
              "qualified"
            ]
          },
          "then": {
            "required": [
              "id",
              "phase",
              "status"
            ],
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          }
        }
      ]
    },
    "sn_curve": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_label": {
          "type": "string",
          "minLength": 1
        },
        "m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "log_a": {
          "type": "number"
        },
        "thickness_correction": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/thickness_correction"
            }
          ]
        },
        "reference_cycles": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_range_MPa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "endurance_limit_MPa": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "m",
        "log_a"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "source_label"
          ]
        }
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "thickness_correction": {
      "type": "object",
      "properties": {
        "thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exponent": {
          "type": "number",
          "minimum": 0
        },
        "source_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "thickness_mm",
        "reference_thickness_mm",
        "exponent",
        "source_label"
      ],
      "additionalProperties": false
    }
  }
}
