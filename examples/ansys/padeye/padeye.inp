! Padeye (lifting-lug) screening FE — generated by digitalmodel.ansys.padeye
! Units: mm, N, MPa (plane stress with thickness)
! QUALIFICATION PENDING: generation establishes no solved stress or mesh convergence.
FINISH
/CLEAR,NOSTART
/TITLE,Padeye screening: t=80.0mm hole=80.0mm
/UNITS,MPA
/PREP7

! --- material (linear elastic steel) ---
MP,EX,1,205000.0
MP,PRXY,1,0.3

! --- element: PLANE182, plane stress with thickness ---
ET,1,PLANE182
KEYOPT,1,3,3            ! plane stress with thickness
R,1,80.0  ! plate thickness (real constant)

! --- geometry: main plate minus pin hole ---
BLC4,0,0,400.0,300.0   ! area 1 = plate
CYL4,200.0,220.0,40.0                                       ! area 2 = hole disk
ASBA,1,2               ! subtract hole -> plate-with-hole area

! --- mesh ---
TYPE,1
MAT,1
REAL,1
ESIZE,10.0
AMESH,ALL

! --- boundary conditions: fix the weld base (bottom edge y=0) ---
NSEL,S,LOC,Y,0
D,ALL,ALL,0
ALLSEL,ALL

! --- load: sling bearing force on the upper hole arc ---
LOCAL,11,1,200.0,220.0,0     ! cylindrical CS at hole centre
CSYS,11
NSEL,S,LOC,X,39.2,40.8   ! nodes on the hole edge (radius ~ r)
NSEL,R,LOC,Y,0,180                    ! upper semicircle (loaded arc)
CSYS,0
*GET,nload,NODE,0,COUNT
fx_n = 0.0 / nload
fy_n = 500000.0 / nload
F,ALL,FX,fx_n
F,ALL,FY,fy_n
ALLSEL,ALL

! --- solve (static structural) ---
/SOLU
ANTYPE,STATIC
SOLVE
FINISH

! --- post: peak von Mises + unity check ---
/POST1
SET,LAST
CSYS,0
RSYS,0
ALLSEL,ALL
NSORT,S,EQV
*GET,smax,SORT,0,MAX
*GET,peak_node,SORT,0,IMAX
*GET,peak_x,NODE,peak_node,LOC,X
*GET,peak_y,NODE,peak_node,LOC,Y
*GET,peak_z,NODE,peak_node,LOC,Z
allow = 212.57485029940122
uc = smax / allow
mesh_size = 10.0

! --- equilibrium: support nodes only, all structural elements retained ---
! FSUM reports signed support force; reaction + applied load shall balance.
ALLSEL,ALL
NSEL,S,LOC,Y,0
FSUM
*GET,rfx,FSUM,0,ITEM,FX
*GET,rfy,FSUM,0,ITEM,FY
*GET,rfz,FSUM,0,ITEM,FZ
ALLSEL,ALL
applied_fx = 0.0
applied_fy = 500000.0
balance_n = SQRT((rfx + applied_fx)**2 + (rfy + applied_fy)**2 + rfz**2)
/COM,============================================================
/COM,PADEYE SCREENING RESULT
*MSG,INFO,smax,allow,uc
peak von Mises = %G MPa ; allowable = %G MPa ; UC = %G
/COM,============================================================
! numeric digest for the postprocessor (small, returnable)
*CFOPEN,padeye_result,csv
*VWRITE,smax,allow,uc
('max_seqv_mpa,',F12.4,',allowable_mpa,',F12.4,',uc,',F10.5)
*VWRITE,peak_node
('peak_node,',F12.0)
*VWRITE,peak_x,peak_y,peak_z
('peak_x_mm,',E20.12,',peak_y_mm,',E20.12,',peak_z_mm,',E20.12)
*VWRITE,mesh_size
('mesh_size_mm,',E20.12)
*VWRITE,applied_fx,applied_fy
('applied_fx_n,',E20.12,',applied_fy_n,',E20.12)
*VWRITE,rfx,rfy,rfz
('reaction_fx_n,',E20.12,',reaction_fy_n,',E20.12,',reaction_fz_n,',E20.12)
*VWRITE,balance_n
('force_residual_n,',E20.12)
*CFCLOS
FINISH
