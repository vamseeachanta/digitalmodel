# ==========================================
# Root Directory Hygiene
# ==========================================

# Prevent test files in root
/test_*.py
/*_test.py
/test_*.yml

# Prevent backup files in root
/*.backup*
/*.bak
/*~
/*.old

# Prevent migration files in root
/*migration*
/*upgrade*
/requirements-*.txt

# Prevent temporary files in root
/tmp*
/temp*
/*.tmp
/nul
/.command-*
/agos
/tools

# Claude temp working directories
tmpclaude-*-cwd

# AI agent session working directories (Codex, Gemini)
# Transient per-session dirs; aggregated output lives in workspace-hub/.claude/skills/session-logs/
.codex/Cu*/
.gemini/Cu*/

# Temp test directories
/temp_test_conversion/
/temp_workflow_test/

# Prevent config files in root (except whitelisted)
/*.yml
/*.yaml
!docker-compose.yml
!mkdocs.yml
!.pre-commit-config.yaml
# The rules the client-identifier gate reads. Without this exception the root
# hygiene rule above swallows it, the gate finds no rules file and exits
# non-zero, and the natural fix is to disable the gate. That is the same shape
# as the `env/` rule that silently excluded model inputs for eight months.
!.legal-deny-list.yaml
/*.json
!package.json
/*.ini

# Prevent batch files in root
/batch_*.yml
/fsts_*.yml
/*_batch.yml

# Prevent generated files in root
/*.log
/*.pid
/*.cache

