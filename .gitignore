# ==========================================
# Virtual Environments
# ==========================================

.venv/
venv/
ENV/
/env/
# Nested environments are ignored by specific environment paths, not by env/.
**/env/pyvenv.cfg
**/env/bin/python*
**/env/bin/activate*
**/env/bin/pip*
**/env/Scripts/python*.exe
**/env/Scripts/activate*
**/env/Scripts/Activate.ps1
**/env/Scripts/pip*.exe
**/env/Lib/site-packages/
**/env/lib/python*/site-packages/
**/env/lib64/python*/site-packages/
**/env/include/python*/
env.bak/
venv.bak/

# `/env/` above is root-anchored. Nested environments are covered by the
# specific paths above; ordinary engineering inputs under env/ stay visible.
# Generic include/, bin/ and Scripts/ content is not excluded by these rules.
# Existing lib/ and lib64/ rules remain in effect independently.
#
# Engineering input under docs/ is re-included explicitly, and ONLY the YAML
# case files. The directory is opened so its *.yml can be seen, then everything
# else inside it is ignored again: a virtual environment created under docs/
# (pyvenv.cfg, Lib/, Scripts/activate) stays ignored. Review found an earlier
# `!docs/**/env/**` re-included all of that.
#
# There is deliberately no equivalent for `projects/`. That tree is excluded
# wholesale further down, and git cannot re-include a file whose parent
# directory is excluded, so a `!projects/**/env/` line here would read as a fix
# and do nothing. Re-including anything under `projects/` requires opening the
# directory chain first and is a separate change.
!docs/**/env/
docs/**/env/**
!docs/**/env/*.yml
.python-version
__pypackages__/

