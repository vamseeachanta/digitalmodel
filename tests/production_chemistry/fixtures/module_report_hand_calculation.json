  "schema_version": 1,
  "worksheet_id": "productionchemistry-synthetic-endpoints-v1",
  "method": "Hand-calculation worksheet: inputs and coefficients are transcribed as decimal literals. The equations below are evaluated independently with 40-digit decimal arithmetic (base-10 logarithms and square roots), without importing or calling the chemistry API. Stored numerical results retain 15 significant figures. Tests read these committed expectations without recomputing them through the API.",
  "qualification": "Independent arithmetic oracle for the repository's synthetic example, not an experimental benchmark. Defaults are uncalibrated; quantitative physical validity remains unestablished.",
  "units": {
    "concentration": "mg/L",
    "molecular_mass": "g/mol",
    "molarity": "mol/L",
    "ionic_strength": "mol/L",
    "temperature": "degF",
    "pressure": "psia",
    "si": "dimensionless",
    "ph": "dimensionless",
    "logarithmic_terms": "base-10 numerical values on the stated conditional-concentration and psia basis"
  },
  "equations": {
    "molarity": "c_i = concentration_i / (1000 * molecular_mass_i)",
    "ionic_strength": "I = sum(c_i * charge_i^2 / 2)",
    "polynomial": "K = a0 + a_t*T + a_t2*T^2 + a_t3*T^3 + a_p*P + a_sqrt_i*sqrt(I) + a_i*I",
    "co2_pressure": "f_CO2 = 0.02 * P (fugacity coefficient = 1)",
    "calcite_product": "IAP_calcite = c_Ca * c_HCO3^2 / f_CO2",
    "sulfate_product": "IAP_sulfate = c_cation * c_SO4",
    "halite_product": "IAP_halite = c_Na * c_Cl",
    "index": "SI = log10(IAP) + K",
    "ph": "estimated_pH = log10(c_HCO3 / f_CO2) + K_ph_from_co2",
    "delta": "dSI = SI_endpoint - SI_bottomhole"
  },
