<p>The numerical pre-flight checks compare every displayed example value and every spectrum ordinate with fresh function outputs, bind the inputs to the public example and compare rebuilt document text. A passing comparison establishes reproduction only. The delivery checks inspect section structure, embedded resources and visible wording. Browser interaction and native engineering qualification require separate evidence.</p>
<h2>Appendix B. Comments</h2>
<p>Comments remain local. Save the comments file beside this document using the file chooser. Where that facility is unavailable, the download fallback requires the destination to be selected manually. Import a saved file to resume annotation.</p>
<label>Section <select id="comment-section"></select></label>
<label>Comment <textarea id="comment" rows="4" style="width:100%"></textarea></label>
<button id="add-comment" type="button">Add comment</button>
<button id="save-comments" type="button">Save comments beside report</button>
<label>Import comments <input id="import-comments" type="file" accept="application/json"></label>
<p id="comment-status" role="status"></p><ul id="comments"></ul>
</main>
<script id="example-data" type="application/json">{{data}}</script>
<script id="changes-data" type="application/json">{{changes}}</script>
<script>
const data = JSON.parse(document.getElementById('example-data').textContent);
const changes = JSON.parse(document.getElementById('changes-data').textContent);
changes.changes.forEach(text => {const li = document.createElement('li'); li.textContent = text; document.getElementById('changes').append(li);});
const svg = document.getElementById('spectrum'), ns = 'http://www.w3.org/2000/svg';
const maximum = Math.max(...data.response), lower = data.omega[0], upper = data.omega.at(-1);
function element(tag, attrs, text) {
  const node = document.createElementNS(ns, tag);
  Object.entries(attrs).forEach(([key,value]) => node.setAttribute(key,value));
  if (text !== undefined) node.textContent = text;
  svg.append(node); return node;
}
const x = value => 80 + 640 * (value-lower)/(upper-lower);
const y = value => 285 - 240 * value/maximum;
element('line', {x1:80,y1:285,x2:720,y2:285,stroke:'var(--nogo)','stroke-dasharray':'6 4'});
element('text', {x:410,y:335,'text-anchor':'middle'}, 'Angular frequency (rad/s)');
element('text', {x:80,y:20}, 'Response spectral density (m²·s/rad)');
element('text', {x:80,y:310}, lower.toPrecision(3));
element('text', {x:690,y:310}, upper.toPrecision(3));
element('text', {x:25,y:285}, '0');
element('text', {x:10,y:50}, maximum.toPrecision(3));
element('polyline', {points:data.omega.map((w,i)=>`${x(w)},${y(data.response[i])}`).join(' '),fill:'none',stroke:'var(--brand)','stroke-width':2});
const marker = element('circle',{r:5,fill:'var(--brand)'}), slider=document.getElementById('point');
slider.max=data.omega.length-1;
function showPoint(index) {
  slider.value=index; marker.setAttribute('cx',x(data.omega[index])); marker.setAttribute('cy',y(data.response[index]));
  document.getElementById('readout').textContent=`Case: public synthetic example; component: vertical translation; angular frequency: ${data.omega[index].toPrecision(6)} rad/s; demand density: ${data.response[index].toExponential(4)} m²·s/rad; lower bound: 0 m²·s/rad; operating limit: NOT_EVALUATED.`;
}
slider.addEventListener('input',()=>showPoint(Number(slider.value)));
svg.addEventListener('pointermove',event=>{const rect=svg.getBoundingClientRect();const px=(event.clientX-rect.left)*760/rect.width;showPoint(Math.max(0,Math.min(data.omega.length-1,Math.round((px-80)/640*(data.omega.length-1)))));});
showPoint(0);
let comments=[];
const sections=document.getElementById('comment-section'), status=document.getElementById('comment-status');
document.querySelectorAll('h2').forEach(heading=>{const option=document.createElement('option');option.textContent=heading.textContent;sections.append(option);});
function showComments(){const list=document.getElementById('comments');list.replaceChildren();comments.forEach(c=>{const li=document.createElement('li');li.textContent=`${c.section}: ${c.text}`;list.append(li);});}
document.getElementById('add-comment').onclick=()=>{const input=document.getElementById('comment');if(input.value.trim()){comments.push({section:sections.value,text:input.value.trim()});input.value='';showComments();status.textContent='Comment added in memory. Save to retain it.';}};
document.getElementById('save-comments').onclick=async()=>{
  const text=JSON.stringify({revision:'A',comments},null,2);
  try {if(window.showSaveFilePicker){const handle=await window.showSaveFilePicker({suggestedName:'comments.json',types:[{description:'Comments',accept:{'application/json':['.json']}}]});const stream=await handle.createWritable();await stream.write(text);await stream.close();status.textContent='Comments saved to the selected file.';}
  else {const url=URL.createObjectURL(new Blob([text],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='comments.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);status.textContent='Download requested. Place comments.json beside the report.';}}
  catch(error){status.textContent='Comments were not saved. '+error.message;}
};
document.getElementById('import-comments').onchange=async event=>{
  try {const file=event.target.files[0];if(!file)return;const saved=JSON.parse(await file.text());if(saved.revision!=='A'||!Array.isArray(saved.comments)||!saved.comments.every(c=>typeof c.section==='string'&&typeof c.text==='string'))throw Error('Invalid comments format');comments=saved.comments;showComments();status.textContent='Saved comments imported.';}
  catch(error){status.textContent='Import failed. '+error.message;}
};
</script></body></html>
