<tr><td>Second response moment</td><td>{{m2}}</td><td>m²·(rad/s)²</td><td>Section 4.1 integration</td></tr>
<tr><td>Fourth response moment</td><td>{{m4}}</td><td>m²·(rad/s)⁴</td><td>Section 4.1 integration</td></tr>
