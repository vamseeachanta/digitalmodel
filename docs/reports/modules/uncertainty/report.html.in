</section>
<section id="section-10"><h2>10. Appendix: Data Register and Review Notes</h2>
<p>Data readiness and checking scope are recorded below. The mathematical example is suitable for numerical demonstration only.</p>
<h3>10.1 Data register and quality checks</h3>
<table><thead><tr><th>Item</th><th>Basis and readiness</th><th>Disposition</th></tr></thead><tbody>
<tr><td>Linear response and distribution parameters</td><td>Public example inputs; dimensionless</td><td>Used for numerical demonstration</td></tr>
<tr><td>Independent slope and offset</td><td>ASSUMED - to be confirmed for any application</td><td>Required by the analytical variance comparison</td></tr>
<tr><td>Physical distributions and operating limit</td><td>NOT_EVALUATED; no application supplied</td><td>Required inputs before an engineering decision</td></tr>
<tr><td>Numerical moment comparison</td><td>Existing test tolerances</td><td>Applied only to this example</td></tr>
<tr><td>Arithmetic anchors</td><td>Hand calculations compared with evaluator calls</td><td>Checked by the report test</td></tr>
<tr><td>Sample and display consistency</td><td>All sample rows and summaries compared with module calls; displayed values rounded</td><td>Checked by the report test</td></tr>
<tr><td>Report integrity</td><td>Regeneration, internal links and prohibited wording</td><td>Direct regeneration produced identical content. Number, link and wording checks pass. The automated rebuild fixture remains not evaluated because temporary-folder access was denied. Real-browser comment saving remains not evaluated.</td></tr>
</tbody><caption>Table 2. Data register and quality-check scope.</caption></table>
<p>The mathematical symbols are defined in the inputs and basis sections. E denotes expectation; Var denotes variance; μ denotes the normal mean; σ denotes its standard deviation; L and H denote uniform bounds; n denotes sample count; p denotes cumulative probability.</p>
<h3>10.2 Engineering changes and comments</h3>
<details><summary>Engineering changes</summary><ul id="change-list"></ul></details>
<label for="comment-section">Comment section</label><select id="comment-section"></select>
<p><label for="comment">Review comment</label><br><textarea id="comment" rows="5" cols="55"></textarea></p>
<button id="add-comment" type="button">Add comment</button>
<button id="save-comments" type="button">Save comments beside report</button>
<label>Load saved comments <input id="load-comments" type="file" accept="application/json"></label>
<p id="comment-status" aria-live="polite">Comments remain in this page until saved. Select the report folder to save beside the report. If folder access is unavailable, save the downloaded comments file beside the report manually.</p>
<ol id="comments"></ol>
</section></main></div>
<script id="evidence" type="application/json">@@EVIDENCE@@</script>
<script id="changes" type="application/json">@@CHANGES@@</script>
<script>
const evidence = JSON.parse(document.getElementById('evidence').textContent);
const svg = document.getElementById('chart');
function drawChart() {
  const metric = document.getElementById('metric').value;
  const demand = Math.abs(evidence[metric + '_difference_pct']);
  const limit = evidence[metric + '_limit_pct'];
  const ymax = Math.max(limit, demand) * 1.25;
  const y = value => 220 - 180 * value / ymax;
  const description = `Linear example; response ${metric}; absolute difference ${demand.toFixed(3)} %; limit ${limit.toFixed(3)} %.`;
  svg.innerHTML = `<path d="M80 30V220H660" fill="none" stroke="#183449"/>
    <text x="85" y="20">Absolute difference (%)</text><text x="290" y="260">Response ${metric}</text>
    <path d="M80 ${y(limit)}H660" stroke="#137e8a" stroke-dasharray="8 4"/>
    <text x="440" y="${y(limit)-8}">Limit ${limit.toFixed(3)} %</text>
    <text x="30" y="224">0</text>
    <circle tabindex="0" role="img" aria-label="${description}" cx="350" cy="${y(demand)}" r="7" fill="#183449"><title>${description}</title></circle>`;
  document.getElementById('chart-detail').textContent = description;
}
document.getElementById('metric').addEventListener('change', drawChart);
drawChart();
for (const text of JSON.parse(document.getElementById('changes').textContent).changes) {
  const li = document.createElement('li'); li.textContent = text;
  document.getElementById('change-list').append(li);
}
for (const heading of document.querySelectorAll('section > h2')) {
  const option = document.createElement('option'); option.textContent = heading.textContent;
  document.getElementById('comment-section').append(option);
}
let comments = [];
function renderComments() {
  document.getElementById('comments').replaceChildren();
  for (const item of comments) {
    const li = document.createElement('li'); li.textContent = item.section + ': ' + item.text;
    document.getElementById('comments').append(li);
  }
}
document.getElementById('add-comment').onclick = () => {
  const field = document.getElementById('comment');
  if (!field.value.trim()) return;
  comments.push({section: document.getElementById('comment-section').value, text: field.value.trim()});
  field.value = ''; renderComments();
};
document.getElementById('save-comments').onclick = async () => {
  const content = JSON.stringify({revision: 'Initial', comments}, null, 2) + '\n';
  const status = document.getElementById('comment-status');
  try {
    if ('showDirectoryPicker' in window) {
      const directory = await window.showDirectoryPicker({mode: 'readwrite'});
      const file = await directory.getFileHandle('uncertainty.comments.json', {create: true});
      const writer = await file.createWritable(); await writer.write(content); await writer.close();
      status.textContent = 'Comments saved in the selected folder.';
    } else {
      const url = URL.createObjectURL(new Blob([content], {type: 'application/json'}));
      const link = document.createElement('a'); link.href = url; link.download = 'uncertainty.comments.json';
      link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
      status.textContent = 'Download requested. Place the comments file beside the report.';
    }
  } catch (error) { status.textContent = 'Comments were not saved: ' + error.message; }
};
document.getElementById('load-comments').onchange = async event => {
  try {
    if (!event.target.files.length) return;
    const data = JSON.parse(await event.target.files[0].text());
    if (data.revision !== 'Initial' || !Array.isArray(data.comments) ||
        !data.comments.every(item => typeof item.section === 'string' && typeof item.text === 'string')) {
      throw new Error('The comment file format is invalid.');
    }
    comments = data.comments; renderComments();
    document.getElementById('comment-status').textContent = 'Saved comments loaded.';
  } catch (error) { document.getElementById('comment-status').textContent = 'Comments were not loaded: ' + error.message; }
};
</script></body></html>
