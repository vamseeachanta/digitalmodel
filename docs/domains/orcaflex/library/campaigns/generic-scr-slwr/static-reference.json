{
  "schema_version": "generic-static-reference-v1",
  "method": "OO low-point geometry; general elastic solver on each reflected arc",
  "limitations": "Zero mean host offset, quiescent water, inextensible OO geometry and elastic general catenary segment checks. Pipe centre at contact radius above seabed. No pressure, bending/contact soil response, wave dynamics, VIV or code acceptance. Both seabed reserves are additionally derived across the intact and damaged offset envelope using a flat-seabed, inextensible catenary with frictionless suspended geometry. Full adverse axial seabed friction bounds grounded tension; this does not establish native offset equilibrium.",
  "geometry_comparison": "General arc endpoints and unstretched lengths are prescribed from OO geometry; their equality is not an independent global geometry check. Elastic arc horizontal tensions need not be continuous.",
  "seabed_axial_friction": {
    "model_settings": "Both models specify SeabedLateralFrictionCoefficient = 0.5 and SeabedAxialFrictionCoefficient = ~ on every line type. Neither model text explicitly specifies a static friction application switch.",
    "coefficient_status": "ASSUMED",
    "coefficient_basis": "Assumed, based on previous experience; the inherited axial default is treated as equal to the committed lateral coefficient, 0.5. The program interpretation of the default requires native readback.",
    "statics_application_status": "ASSUMED",
    "statics_application": "Axial friction is assumed active in statics and fully mobilized in the adverse sense at every offset. Actual program application and mobilization are not established by the committed text and require a native statics check.",
    "sense": "Grounded tension decreases from touchdown toward anchored End B, with dT/ds = -mu*w. The reverse sense increases anchor tension; partial mobilization lies between these bounds. No friction acts on the suspended arc in the hand model.",
    "hand_estimate": "T_min = H - mu*w*L_grounded. H is touchdown horizontal tension, mu is the assumed axial coefficient and w is bare-pipe submerged weight. Grounded tension is linear and suspended tension is at least H, so the anchored-end estimate bounds the complete line at zero pressure.",
    "scr_selection": "Preserve the nominal suspended arc and reduce anchor X and bottom length equally. Select the largest bottom on the existing 0.1 m grid, no longer than the requested reserve design, for which every static sweep step has at least the assumed positive tension margin and positive grounded length. This is the smallest joint reduction within that geometry-preserving family.",
    "limits": "The positive margin is a numerical screening assumption, not a qualified dynamic or design allowance. The original requested grounded reserve may be reduced by the tension constraint. Static sweep spacing and touchdown-step acceptance criteria are unchanged; no native or dynamic acceptance is asserted."
  },
  "formulas": [
    "h = water_depth - hangoff_depth - coated_OD/2",
    "EA = young_modulus*pi/4*(steel_OD^2-steel_ID^2)",
    "w_pipe = (steel_mass+coating_mass+contents_mass-rho_water*pi/4*coated_OD^2)*g",
    "module_volume_per_m = pi/4*(module_OD^2-coated_OD^2)*module_length/module_pitch",
    "w_buoyed = w_pipe - (rho_water-rho_module)*module_volume_per_m*g",
    "a = H/w; S = sqrt(h*(h+2*a)); X = a*acosh(1+h/a)",
    "D = anchor_X - host_offset; solve X-S = D-L; grounded = L-S",
    "Requested bottom = ceil(10*(maximum suspended-length increase + margin))/10",
    "T_min = H - mu*w*L_grounded; assumed full adverse axial friction in statics",
    "SCR bottom = min(requested bottom, floor(10*min(S-S_nominal+(H-T_margin)/(mu*w)))/10); forces in N",
    "Piecewise arcs: dx/ds = H/sqrt(H^2+V^2); dy/ds = V/sqrt(H^2+V^2); dV/ds = w"
  ],
