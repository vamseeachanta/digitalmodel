  "calibrates": {
    "description": "static hand-calculation check of a single line against the closed-form catenary",
    "band": {
      "top_tension": {
        "kind": "relative",
        "percent": 5.0
      },
      "top_angle": {
        "kind": "absolute",
        "degrees": 1.0
      },
      "touchdown_horizontal_distance": {
        "kind": "relative",
        "percent": 5.0
      }
    },
    "applies_to": "each case, program result against the expected value"
  },
  "results_to_export": [
    "Effective tension at End B (kN)",
    "Declination at End B (degrees, 0 to 180 from global +Z, tangent A to B); angle from vertical = min(Declination, 180 - Declination)",
    "Horizontal distance from End B to touchdown (m): X minus the touchdown x coordinate"
  ],
