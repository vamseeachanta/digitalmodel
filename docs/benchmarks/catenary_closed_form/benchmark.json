      },
      "governing_form": "elastic",
      "top_strain_percent": 0.7544298348422861,
      "model_file": "docs/benchmarks/catenary_closed_form/inputs/catenary_c2_elastic.yml",
      "expected": {
        "top_tension_kN": 150.886,
